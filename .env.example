# GitHub — needed for git push + PR creation inside the container
# Create a personal access token at https://github.com/settings/tokens (repo scope)
GH_TOKEN=

# Git identity for commits made by the agent
GIT_AUTHOR_NAME=eve-agent
GIT_AUTHOR_EMAIL=eve@agent.local
GIT_COMMITTER_NAME=eve-agent
GIT_COMMITTER_EMAIL=eve@agent.local

# Slack — needed for the Slack channel (eve/channels/slack)
# Create a Slack app at https://api.slack.com/apps → "From scratch"
# Bot Token Scopes: app_mentions:read, chat:write, files:write, im:history
# Event Subscriptions → Request URL: https://<your-host>/eve/v1/slack
# Subscribe to: app_mention, message.im
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# AI model — defaults to zai/glm-5.2 (no vision). Switch to a vision model
# (e.g. google/gemini-2.5-flash) to let the agent actually see the desktop.
AI_MODEL=zai/glm-5.2
