{
  "name": "eve-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "eve agent + web UI that operates the Docker Linux desktop via the computer-use-sdk",
  "scripts": {
    "setup": "npm --prefix ../sdk run build",
    "postinstall": "npm --prefix ../sdk run build && node scripts/link-sdk.mjs",
    "refresh-sdk": "npm --prefix ../sdk run build && npm install --no-audit --no-fund",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "computer-use-sdk": "file:../sdk",
    "eve": "latest",
    "lucide-react": "^1.31.0",
    "next": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
